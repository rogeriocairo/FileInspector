@FileInspector.API_HostAddress = http://localhost:5000

### Find duplicate file names under the configured Files directory
GET {{FileInspector.API_HostAddress}}/api/files/duplicates
Accept: application/json

###

### Find duplicate file names under a subdirectory of Files
GET {{FileInspector.API_HostAddress}}/api/files/duplicates?path=Samples
Accept: application/json
